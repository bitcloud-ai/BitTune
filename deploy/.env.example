# Every image value must be replaced with a verified immutable digest.
AUTOPILOT_API_IMAGE=registry.example.invalid/bittune-autopilot@sha256:REPLACE_WITH_G0_DIGEST
AUTOPILOT_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_VERIFIED_DIGEST
AUTOPILOT_OPA_IMAGE=openpolicyagent/opa@sha256:REPLACE_WITH_VERIFIED_DIGEST

AUTOPILOT_POSTGRES_DB=autopilot
AUTOPILOT_POSTGRES_USER=autopilot
AUTOPILOT_POSTGRES_PASSWORD=REPLACE_WITH_DEPLOYMENT_SECRET

AUTOPILOT_API_OPERATOR_USER_ID=user_REPLACE_WITH_32_LOWERCASE_HEX
AUTOPILOT_API_OPERATOR_TOKEN_HASH=sha256:REPLACE_WITH_64_LOWERCASE_HEX
AUTOPILOT_API_ADMIN_USER_ID=user_REPLACE_WITH_DIFFERENT_32_LOWERCASE_HEX
AUTOPILOT_API_ADMIN_TOKEN_HASH=sha256:REPLACE_WITH_64_LOWERCASE_HEX

# Leave the three ModelProvider settings empty to start fail-closed; the key file must then be empty.
AUTOPILOT_API_MODEL_PROVIDER_BASE_URL=
AUTOPILOT_API_MODEL_PROVIDER_MODEL=
AUTOPILOT_MODEL_PROVIDER_API_KEY_FILE=/etc/autopilot/secrets/model-provider-api-key

# JSON values are parsed by Pydantic Settings. Keep Provider lists empty until G0 verifies them.
AUTOPILOT_API_AGENT_BUDGET_CEILING={"schema_version":"execution-budget/v1","max_duration_seconds":1800,"max_requests":10000,"max_input_tokens":25000000,"max_output_tokens":25000000,"max_disk_growth_bytes":20000000000}
AUTOPILOT_API_AGENT_VERIFIED_PROVIDERS=[]
AUTOPILOT_API_AGENT_HARDWARE_CAPABILITIES=[]
AUTOPILOT_API_AGENT_ENABLED_PROVIDERS=[]
AUTOPILOT_API_AGENT_ENABLED_FEATURE_FLAGS=[]
