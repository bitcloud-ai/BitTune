{
  "$defs": {
    "ArtifactDataset": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "artifact"
      ],
      "title": "ArtifactDataset",
      "type": "object"
    },
    "ArtifactId": {
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "ArtifactProducer",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "content_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ArtifactProducer"
        },
        "schema_version": {
          "const": "artifact-ref/v1",
          "default": "artifact-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "size_bytes": {
          "maximum": 100000000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "content_type",
        "size_bytes",
        "producer"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ModelRevision": {
      "description": "Immutable model repository commit revision.",
      "title": "ModelRevision",
      "type": "string"
    },
    "SamplingSpec": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "temperature": {
          "const": 0,
          "default": 0,
          "title": "Temperature",
          "type": "integer"
        }
      },
      "required": [
        "seed"
      ],
      "title": "SamplingSpec",
      "type": "object"
    },
    "Sha256Digest": {
      "description": "Lowercase SHA-256 digest with an explicit algorithm prefix.",
      "title": "Sha256Digest",
      "type": "string"
    },
    "SyntheticFixedDataset": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}-v[1-9][0-9]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "type": {
          "const": "synthetic_fixed",
          "default": "synthetic_fixed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "SyntheticFixedDataset",
      "type": "object"
    },
    "TokenizerRef": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Repository Id",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/ModelRevision"
        }
      },
      "required": [
        "repository_id",
        "revision"
      ],
      "title": "TokenizerRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "discriminator": {
        "mapping": {
          "artifact": "#/$defs/ArtifactDataset",
          "synthetic_fixed": "#/$defs/SyntheticFixedDataset"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SyntheticFixedDataset"
        },
        {
          "$ref": "#/$defs/ArtifactDataset"
        }
      ],
      "title": "Dataset"
    },
    "ignore_eos": {
      "title": "Ignore Eos",
      "type": "boolean"
    },
    "output_tokens": {
      "maximum": 50000000,
      "minimum": 1,
      "title": "Output Tokens",
      "type": "integer"
    },
    "prompt_tokens": {
      "maximum": 50000000,
      "minimum": 1,
      "title": "Prompt Tokens",
      "type": "integer"
    },
    "sampling": {
      "$ref": "#/$defs/SamplingSpec"
    },
    "schema_version": {
      "const": "workload/v1",
      "default": "workload/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stream": {
      "title": "Stream",
      "type": "boolean"
    },
    "tokenizer": {
      "$ref": "#/$defs/TokenizerRef"
    }
  },
  "required": [
    "dataset",
    "tokenizer",
    "prompt_tokens",
    "output_tokens",
    "stream",
    "ignore_eos",
    "sampling"
  ],
  "title": "WorkloadSpec",
  "type": "object"
}
