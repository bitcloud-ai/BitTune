{
  "$defs": {
    "ArtifactDataset": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "artifact"
      ],
      "title": "ArtifactDataset",
      "type": "object"
    },
    "ArtifactId": {
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactModelRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "revision": {
          "$ref": "#/$defs/ModelRevision"
        },
        "type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "revision"
      ],
      "title": "ArtifactModelRef",
      "type": "object"
    },
    "ArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "ArtifactProducer",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "content_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ArtifactProducer"
        },
        "schema_version": {
          "const": "artifact-ref/v1",
          "default": "artifact-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "size_bytes": {
          "maximum": 100000000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "content_type",
        "size_bytes",
        "producer"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BooleanConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "boolean",
          "default": "boolean",
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "const": "oom",
          "default": "oom",
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "const": "==",
          "default": "==",
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "const": false,
          "default": false,
          "title": "Value",
          "type": "boolean"
        }
      },
      "title": "BooleanConstraint",
      "type": "object"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_disk_growth_bytes": {
          "maximum": 20000000000,
          "minimum": 1,
          "title": "Max Disk Growth Bytes",
          "type": "integer"
        },
        "max_duration_seconds": {
          "maximum": 1800,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_input_tokens": {
          "maximum": 50000000,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "maximum": 50000000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_requests": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "schema_version": {
          "const": "execution-budget/v1",
          "default": "execution-budget/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "max_duration_seconds",
        "max_requests",
        "max_input_tokens",
        "max_output_tokens",
        "max_disk_growth_bytes"
      ],
      "title": "ExecutionBudget",
      "type": "object"
    },
    "HuggingFaceModelRef": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Repository Id",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/ModelRevision"
        },
        "type": {
          "const": "huggingface",
          "default": "huggingface",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "revision"
      ],
      "title": "HuggingFaceModelRef",
      "type": "object"
    },
    "ModelRevision": {
      "description": "Immutable model repository commit revision.",
      "title": "ModelRevision",
      "type": "string"
    },
    "NumericConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "numeric",
          "default": "numeric",
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/NumericMetric"
        },
        "operator": {
          "$ref": "#/$defs/NumericOperator"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "operator",
        "value"
      ],
      "title": "NumericConstraint",
      "type": "object"
    },
    "NumericMetric": {
      "enum": [
        "e2e_p50_ms",
        "e2e_p95_ms",
        "e2e_p99_ms",
        "ttft_p50_ms",
        "ttft_p95_ms",
        "ttft_p99_ms",
        "tpot_p50_ms",
        "tpot_p95_ms",
        "tpot_p99_ms",
        "itl_p50_ms",
        "itl_p95_ms",
        "itl_p99_ms",
        "requests_per_second",
        "successful_requests_per_minute",
        "input_tokens_per_second",
        "successful_output_tokens_per_second",
        "total_tokens_per_minute",
        "success_rate",
        "window_completion_ratio"
      ],
      "title": "NumericMetric",
      "type": "string"
    },
    "NumericOperator": {
      "enum": [
        "<=",
        ">="
      ],
      "title": "NumericOperator",
      "type": "string"
    },
    "SamplingSpec": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "temperature": {
          "const": 0,
          "default": 0,
          "title": "Temperature",
          "type": "integer"
        }
      },
      "required": [
        "seed"
      ],
      "title": "SamplingSpec",
      "type": "object"
    },
    "Sha256Digest": {
      "description": "Lowercase SHA-256 digest with an explicit algorithm prefix.",
      "title": "Sha256Digest",
      "type": "string"
    },
    "SloSpec": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "items": {
            "discriminator": {
              "mapping": {
                "boolean": "#/$defs/BooleanConstraint",
                "numeric": "#/$defs/NumericConstraint"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NumericConstraint"
              },
              {
                "$ref": "#/$defs/BooleanConstraint"
              }
            ]
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Constraints",
          "type": "array"
        },
        "schema_version": {
          "const": "slo/v1",
          "default": "slo/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "constraints"
      ],
      "title": "SloSpec",
      "type": "object"
    },
    "SyntheticFixedDataset": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}-v[1-9][0-9]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "type": {
          "const": "synthetic_fixed",
          "default": "synthetic_fixed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "SyntheticFixedDataset",
      "type": "object"
    },
    "TokenizerRef": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Repository Id",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/ModelRevision"
        }
      },
      "required": [
        "repository_id",
        "revision"
      ],
      "title": "TokenizerRef",
      "type": "object"
    },
    "WorkloadSpec": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "discriminator": {
            "mapping": {
              "artifact": "#/$defs/ArtifactDataset",
              "synthetic_fixed": "#/$defs/SyntheticFixedDataset"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SyntheticFixedDataset"
            },
            {
              "$ref": "#/$defs/ArtifactDataset"
            }
          ],
          "title": "Dataset"
        },
        "ignore_eos": {
          "title": "Ignore Eos",
          "type": "boolean"
        },
        "output_tokens": {
          "maximum": 50000000,
          "minimum": 1,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_tokens": {
          "maximum": 50000000,
          "minimum": 1,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "sampling": {
          "$ref": "#/$defs/SamplingSpec"
        },
        "schema_version": {
          "const": "workload/v1",
          "default": "workload/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stream": {
          "title": "Stream",
          "type": "boolean"
        },
        "tokenizer": {
          "$ref": "#/$defs/TokenizerRef"
        }
      },
      "required": [
        "dataset",
        "tokenizer",
        "prompt_tokens",
        "output_tokens",
        "stream",
        "ignore_eos",
        "sampling"
      ],
      "title": "WorkloadSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_container_start": {
      "title": "Allow Container Start",
      "type": "boolean"
    },
    "allow_model_download": {
      "title": "Allow Model Download",
      "type": "boolean"
    },
    "budget": {
      "$ref": "#/$defs/ExecutionBudget"
    },
    "model_ref": {
      "discriminator": {
        "mapping": {
          "artifact": "#/$defs/ArtifactModelRef",
          "huggingface": "#/$defs/HuggingFaceModelRef"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HuggingFaceModelRef"
        },
        {
          "$ref": "#/$defs/ArtifactModelRef"
        }
      ],
      "title": "Model Ref"
    },
    "priority": {
      "enum": [
        "balanced",
        "latency",
        "throughput"
      ],
      "title": "Priority",
      "type": "string"
    },
    "schema_version": {
      "const": "create-experiment-plan-input/v1",
      "default": "create-experiment-plan-input/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "slo": {
      "$ref": "#/$defs/SloSpec"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadSpec"
    }
  },
  "required": [
    "model_ref",
    "priority",
    "workload",
    "slo",
    "budget",
    "allow_model_download",
    "allow_container_start"
  ],
  "title": "CreateExperimentPlanInput",
  "type": "object"
}
