{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalId": {
      "title": "ApprovalId",
      "type": "string"
    },
    "PlanHash": {
      "description": "RFC 8785 canonical execution-specification digest.",
      "title": "PlanHash",
      "type": "string"
    },
    "ToolName": {
      "description": "Agent-visible tool name restricted to the public action vocabulary.",
      "title": "ToolName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ToolName"
    },
    "approval_id": {
      "$ref": "#/$defs/ApprovalId"
    },
    "comment": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "expected_plan_hash": {
      "$ref": "#/$defs/PlanHash"
    },
    "schema_version": {
      "default": "plan-decision-request/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "expected_plan_hash",
    "action",
    "decision"
  ],
  "title": "PlanDecisionRequest",
  "type": "object"
}
