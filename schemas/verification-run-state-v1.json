{
  "$defs": {
    "ArtifactId": {
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "ArtifactProducer",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "content_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ArtifactProducer"
        },
        "schema_version": {
          "const": "artifact-ref/v1",
          "default": "artifact-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "size_bytes": {
          "maximum": 100000000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "content_type",
        "size_bytes",
        "producer"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BooleanConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "boolean",
          "default": "boolean",
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "const": "oom",
          "default": "oom",
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "const": "==",
          "default": "==",
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "const": false,
          "default": false,
          "title": "Value",
          "type": "boolean"
        }
      },
      "title": "BooleanConstraint",
      "type": "object"
    },
    "BooleanMetric": {
      "enum": [
        "oom"
      ],
      "title": "BooleanMetric",
      "type": "string"
    },
    "BooleanMetricValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "boolean",
          "default": "boolean",
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/BooleanMetric"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "metric",
        "value"
      ],
      "title": "BooleanMetricValue",
      "type": "object"
    },
    "CandidateId": {
      "title": "CandidateId",
      "type": "string"
    },
    "ChampionPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_coefficient_of_variation": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Coefficient Of Variation",
          "type": "number"
        },
        "minimum_relative_improvement": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Minimum Relative Improvement",
          "type": "number"
        },
        "noise_multiplier": {
          "maximum": 5,
          "minimum": 1,
          "title": "Noise Multiplier",
          "type": "number"
        },
        "schema_version": {
          "const": "champion-policy/v1",
          "default": "champion-policy/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "top_candidate_count": {
          "const": 3,
          "default": 3,
          "title": "Top Candidate Count",
          "type": "integer"
        },
        "verification_repeats": {
          "maximum": 20,
          "minimum": 2,
          "title": "Verification Repeats",
          "type": "integer"
        }
      },
      "required": [
        "verification_repeats",
        "max_coefficient_of_variation",
        "noise_multiplier",
        "minimum_relative_improvement"
      ],
      "title": "ChampionPolicy",
      "type": "object"
    },
    "ConstraintEvaluation": {
      "additionalProperties": false,
      "properties": {
        "constraint": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanConstraint",
              "numeric": "#/$defs/NumericConstraint"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumericConstraint"
            },
            {
              "$ref": "#/$defs/BooleanConstraint"
            }
          ],
          "title": "Constraint"
        },
        "observed": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanMetricValue",
              "numeric": "#/$defs/NumericMetricValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumericMetricValue"
            },
            {
              "$ref": "#/$defs/BooleanMetricValue"
            }
          ],
          "title": "Observed"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "constraint",
        "observed",
        "passed"
      ],
      "title": "ConstraintEvaluation",
      "type": "object"
    },
    "DomainError": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Code",
          "type": "string"
        },
        "field_errors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldError"
          },
          "maxItems": 64,
          "title": "Field Errors",
          "type": "array"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_detail_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "suggested_actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SuggestedAction"
          },
          "maxItems": 8,
          "title": "Suggested Actions",
          "type": "array"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable"
      ],
      "title": "DomainError",
      "type": "object"
    },
    "ErrorCategory": {
      "enum": [
        "validation_error",
        "policy_denied",
        "resource_busy",
        "deployment_error",
        "model_incompatible",
        "benchmark_error",
        "oom",
        "quality_gate_failed",
        "infrastructure_error",
        "unknown_error"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/DomainError"
        },
        "schema_version": {
          "const": "error-envelope/v1",
          "default": "error-envelope/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "EvidenceRunRef": {
      "additionalProperties": false,
      "description": "Stable reference to an external Tracking Run.",
      "properties": {
        "adapter_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "experiment_id": {
          "$ref": "#/$defs/ExperimentId"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "provider": {
          "const": "mlflow",
          "default": "mlflow",
          "title": "Provider",
          "type": "string"
        },
        "provider_profile_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Profile Version",
          "type": "string"
        },
        "provider_run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Run Id",
          "type": "string"
        },
        "provider_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "request_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "schema_version": {
          "const": "evidence-run-ref/v1",
          "default": "evidence-run-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "trial_id": {
          "$ref": "#/$defs/TrialId"
        }
      },
      "required": [
        "provider_version",
        "adapter_version",
        "provider_profile_version",
        "provider_run_id",
        "experiment_id",
        "trial_id",
        "request_hash"
      ],
      "title": "EvidenceRunRef",
      "type": "object"
    },
    "ExperimentId": {
      "title": "ExperimentId",
      "type": "string"
    },
    "FieldError": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[a-zA-Z0-9_.\\[\\]-]{1,256}$",
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "FieldError",
      "type": "object"
    },
    "MeasuredProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "raw_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source": {
          "const": "measured",
          "default": "measured",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_version",
        "adapter_version",
        "raw_artifact"
      ],
      "title": "MeasuredProvenance",
      "type": "object"
    },
    "NumericConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "numeric",
          "default": "numeric",
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/NumericMetric"
        },
        "operator": {
          "$ref": "#/$defs/NumericOperator"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "operator",
        "value"
      ],
      "title": "NumericConstraint",
      "type": "object"
    },
    "NumericMetric": {
      "enum": [
        "e2e_p50_ms",
        "e2e_p95_ms",
        "e2e_p99_ms",
        "ttft_p50_ms",
        "ttft_p95_ms",
        "ttft_p99_ms",
        "tpot_p50_ms",
        "tpot_p95_ms",
        "tpot_p99_ms",
        "itl_p50_ms",
        "itl_p95_ms",
        "itl_p99_ms",
        "requests_per_second",
        "successful_requests_per_minute",
        "input_tokens_per_second",
        "successful_output_tokens_per_second",
        "total_tokens_per_minute",
        "success_rate",
        "window_completion_ratio"
      ],
      "title": "NumericMetric",
      "type": "string"
    },
    "NumericMetricValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "numeric",
          "default": "numeric",
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/NumericMetric"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value"
      ],
      "title": "NumericMetricValue",
      "type": "object"
    },
    "NumericOperator": {
      "enum": [
        "<=",
        ">="
      ],
      "title": "NumericOperator",
      "type": "string"
    },
    "PlanHash": {
      "description": "RFC 8785 canonical execution-specification digest.",
      "title": "PlanHash",
      "type": "string"
    },
    "PlanId": {
      "title": "PlanId",
      "type": "string"
    },
    "Sha256Digest": {
      "description": "Lowercase SHA-256 digest with an explicit algorithm prefix.",
      "title": "Sha256Digest",
      "type": "string"
    },
    "StudyId": {
      "title": "StudyId",
      "type": "string"
    },
    "SuggestedAction": {
      "enum": [
        "revise_plan",
        "check_environment",
        "wait_for_resource",
        "request_approval",
        "contact_operator"
      ],
      "title": "SuggestedAction",
      "type": "string"
    },
    "TrialExecutionStage": {
      "description": "External lifecycle stage that is still running.",
      "enum": [
        "deployment",
        "benchmark"
      ],
      "title": "TrialExecutionStage",
      "type": "string"
    },
    "TrialId": {
      "title": "TrialId",
      "type": "string"
    },
    "TrialRecord": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/CandidateId"
        },
        "constraints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          },
          "maxItems": 16,
          "title": "Constraints",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorEnvelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 64,
          "title": "Evidence",
          "type": "array"
        },
        "objective": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericMetricValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameters": {
          "$ref": "#/$defs/VllmTuningSpec"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasuredProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "optimization-trial/v1",
          "default": "optimization-trial/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TrialStatus"
        },
        "study_id": {
          "$ref": "#/$defs/StudyId"
        },
        "trial_id": {
          "$ref": "#/$defs/TrialId"
        },
        "trial_number": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Trial Number",
          "type": "integer"
        }
      },
      "required": [
        "trial_id",
        "study_id",
        "trial_number",
        "candidate_id",
        "parameters",
        "status"
      ],
      "title": "TrialRecord",
      "type": "object"
    },
    "TrialStatus": {
      "enum": [
        "suggested",
        "rejected_static",
        "deployment_failed",
        "benchmark_failed",
        "oom",
        "constraint_failed",
        "completed",
        "cancelled"
      ],
      "title": "TrialStatus",
      "type": "string"
    },
    "VerificationCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "candidate_index": {
          "exclusiveMaximum": 3,
          "minimum": 0,
          "title": "Candidate Index",
          "type": "integer"
        },
        "provider_resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Resource Id",
          "type": "string"
        },
        "repeat_index": {
          "maximum": 19,
          "minimum": 0,
          "title": "Repeat Index",
          "type": "integer"
        },
        "schema_version": {
          "const": "verification-checkpoint/v1",
          "default": "verification-checkpoint/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/TrialExecutionStage"
        }
      },
      "required": [
        "candidate_index",
        "repeat_index",
        "stage",
        "provider_resource_id"
      ],
      "title": "VerificationCheckpoint",
      "type": "object"
    },
    "VerificationRepeat": {
      "additionalProperties": false,
      "description": "One terminal verification measurement and its Tracking reference.",
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/CandidateId"
        },
        "evidence_run": {
          "$ref": "#/$defs/EvidenceRunRef"
        },
        "repeat_index": {
          "maximum": 19,
          "minimum": 0,
          "title": "Repeat Index",
          "type": "integer"
        },
        "schema_version": {
          "const": "verification-repeat/v1",
          "default": "verification-repeat/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "trial": {
          "$ref": "#/$defs/TrialRecord"
        }
      },
      "required": [
        "candidate_id",
        "repeat_index",
        "trial",
        "evidence_run"
      ],
      "title": "VerificationRepeat",
      "type": "object"
    },
    "VerificationRunState": {
      "description": "One-step Top-candidate verification lifecycle.",
      "enum": [
        "running",
        "pending",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "VerificationRunState",
      "type": "string"
    },
    "VllmTuningSpec": {
      "additionalProperties": false,
      "properties": {
        "enable_chunked_prefill": {
          "title": "Enable Chunked Prefill",
          "type": "boolean"
        },
        "gpu_memory_utilization": {
          "maximum": 0.94,
          "minimum": 0.8,
          "title": "Gpu Memory Utilization",
          "type": "number"
        },
        "max_model_len": {
          "maximum": 50000000,
          "minimum": 1,
          "title": "Max Model Len",
          "type": "integer"
        },
        "max_num_batched_tokens": {
          "enum": [
            2048,
            4096,
            8192,
            16384
          ],
          "title": "Max Num Batched Tokens",
          "type": "integer"
        },
        "max_num_seqs": {
          "enum": [
            4,
            8,
            16,
            32
          ],
          "title": "Max Num Seqs",
          "type": "integer"
        },
        "tensor_parallel_size": {
          "const": 1,
          "default": 1,
          "title": "Tensor Parallel Size",
          "type": "integer"
        },
        "trust_remote_code": {
          "const": false,
          "default": false,
          "title": "Trust Remote Code",
          "type": "boolean"
        }
      },
      "required": [
        "max_model_len",
        "gpu_memory_utilization",
        "max_num_seqs",
        "max_num_batched_tokens",
        "enable_chunked_prefill"
      ],
      "title": "VllmTuningSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Small Job progress payload sufficient to resume verification after restart.",
  "properties": {
    "candidate_ids": {
      "items": {
        "$ref": "#/$defs/CandidateId"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Candidate Ids",
      "type": "array"
    },
    "candidate_index": {
      "maximum": 3,
      "minimum": 0,
      "title": "Candidate Index",
      "type": "integer"
    },
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationCheckpoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experiment_id": {
      "$ref": "#/$defs/ExperimentId"
    },
    "failure_reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "plan_hash": {
      "$ref": "#/$defs/PlanHash"
    },
    "plan_id": {
      "$ref": "#/$defs/PlanId"
    },
    "policy": {
      "$ref": "#/$defs/ChampionPolicy"
    },
    "repeat_index": {
      "maximum": 20,
      "minimum": 0,
      "title": "Repeat Index",
      "type": "integer"
    },
    "repeats": {
      "items": {
        "$ref": "#/$defs/VerificationRepeat"
      },
      "maxItems": 60,
      "title": "Repeats",
      "type": "array"
    },
    "schema_version": {
      "const": "verification-run-state/v1",
      "default": "verification-run-state/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/VerificationRunState"
    }
  },
  "required": [
    "experiment_id",
    "plan_id",
    "plan_hash",
    "policy",
    "candidate_ids",
    "state",
    "candidate_index",
    "repeat_index",
    "repeats"
  ],
  "title": "VerificationRunState",
  "type": "object"
}
