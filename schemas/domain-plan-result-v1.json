{
  "$defs": {
    "ExperimentId": {
      "title": "ExperimentId",
      "type": "string"
    },
    "PlanHash": {
      "description": "RFC 8785 canonical execution-specification digest.",
      "title": "PlanHash",
      "type": "string"
    },
    "PlanId": {
      "title": "PlanId",
      "type": "string"
    },
    "PlanKind": {
      "enum": [
        "environment",
        "capacity",
        "deployment",
        "benchmark",
        "optimization",
        "verification",
        "champion",
        "evidence"
      ],
      "title": "PlanKind",
      "type": "string"
    },
    "PlanStatus": {
      "enum": [
        "draft",
        "approved",
        "rejected",
        "executed"
      ],
      "title": "PlanStatus",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution_schema_version": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$",
      "title": "Execution Schema Version",
      "type": "string"
    },
    "experiment_id": {
      "$ref": "#/$defs/ExperimentId"
    },
    "kind": {
      "$ref": "#/$defs/PlanKind"
    },
    "plan_hash": {
      "$ref": "#/$defs/PlanHash"
    },
    "plan_id": {
      "$ref": "#/$defs/PlanId"
    },
    "requires_approval": {
      "title": "Requires Approval",
      "type": "boolean"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "schema_version": {
      "const": "domain-plan-result/v1",
      "default": "domain-plan-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PlanStatus"
    }
  },
  "required": [
    "experiment_id",
    "plan_id",
    "kind",
    "status",
    "risk_level",
    "plan_hash",
    "execution_schema_version",
    "requires_approval"
  ],
  "title": "DomainPlanResult",
  "type": "object"
}
