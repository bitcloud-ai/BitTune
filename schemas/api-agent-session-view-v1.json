{
  "$defs": {
    "AgentMessageView": {
      "additionalProperties": false,
      "description": "Bounded, JSON-safe message projection returned by the API.",
      "properties": {
        "content": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "default": "agent-message-view/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "AgentMessageView",
      "type": "object"
    },
    "AgentToolCallView": {
      "additionalProperties": false,
      "description": "Tool-call projection suitable for CLI event rendering.",
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "schema_version": {
          "default": "agent-tool-call-view/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_call_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        },
        "tool_name": {
          "$ref": "#/$defs/ToolName"
        }
      },
      "required": [
        "tool_name",
        "arguments",
        "tool_call_id"
      ],
      "title": "AgentToolCallView",
      "type": "object"
    },
    "ExperimentId": {
      "title": "ExperimentId",
      "type": "string"
    },
    "ExperimentPhase": {
      "enum": [
        "requirements",
        "environment",
        "planning",
        "approval",
        "deployment",
        "benchmark",
        "optimization",
        "verification",
        "report",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "ExperimentPhase",
      "type": "string"
    },
    "ExperimentStatus": {
      "enum": [
        "active",
        "waiting_input",
        "waiting_approval",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "ExperimentStatus",
      "type": "string"
    },
    "JsonValue": {},
    "ToolName": {
      "description": "Agent-visible tool name restricted to the public action vocabulary.",
      "title": "ToolName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "$ref": "#/$defs/ExperimentId"
    },
    "interrupt": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interrupt"
    },
    "interrupted": {
      "title": "Interrupted",
      "type": "boolean"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/AgentMessageView"
      },
      "title": "Messages",
      "type": "array"
    },
    "phase": {
      "$ref": "#/$defs/ExperimentPhase"
    },
    "schema_version": {
      "default": "agent-session-view/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExperimentStatus"
    },
    "thread_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Thread Id",
      "type": "string"
    },
    "tool_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentToolCallView"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "tool_set_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Set Id"
    },
    "tool_set_version": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Set Version"
    }
  },
  "required": [
    "experiment_id",
    "thread_id",
    "status",
    "phase",
    "messages",
    "interrupted"
  ],
  "title": "AgentSessionView",
  "type": "object"
}
