{
  "$defs": {
    "ArtifactId": {
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "ArtifactProducer",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "content_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ArtifactProducer"
        },
        "schema_version": {
          "const": "artifact-ref/v1",
          "default": "artifact-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "size_bytes": {
          "maximum": 100000000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "content_type",
        "size_bytes",
        "producer"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ExperimentId": {
      "title": "ExperimentId",
      "type": "string"
    },
    "PlanHash": {
      "description": "RFC 8785 canonical execution-specification digest.",
      "title": "PlanHash",
      "type": "string"
    },
    "PlanId": {
      "title": "PlanId",
      "type": "string"
    },
    "Sha256Digest": {
      "description": "Lowercase SHA-256 digest with an explicit algorithm prefix.",
      "title": "Sha256Digest",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Complete, replayable Artifact index for one verified optimization result.",
  "properties": {
    "candidate_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 480,
      "minItems": 1,
      "title": "Candidate Artifacts",
      "type": "array"
    },
    "champion_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "checksums_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "code_revision": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Code Revision",
      "type": "string"
    },
    "engine_image_digest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "experiment_id": {
      "$ref": "#/$defs/ExperimentId"
    },
    "hardware_passport": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "model_profile": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "model_revision": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "plan_hash": {
      "$ref": "#/$defs/PlanHash"
    },
    "plan_id": {
      "$ref": "#/$defs/PlanId"
    },
    "report_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "requirements": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "evidence-bundle-manifest/v1",
      "default": "evidence-bundle-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "slo": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "trial_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 2000,
      "minItems": 1,
      "title": "Trial Artifacts",
      "type": "array"
    },
    "verification_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Verification Artifacts",
      "type": "array"
    },
    "workload": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "experiment_id",
    "plan_id",
    "plan_hash",
    "hardware_passport",
    "model_profile",
    "model_revision",
    "engine_image_digest",
    "requirements",
    "workload",
    "slo",
    "candidate_artifacts",
    "trial_artifacts",
    "verification_artifacts",
    "champion_artifact",
    "report_artifact",
    "checksums_artifact",
    "code_revision"
  ],
  "title": "EvidenceBundleManifest",
  "type": "object"
}
