{
  "$defs": {
    "BearerTokenHash": {
      "description": "SHA-256 digest of an opaque Bearer Token; never the plaintext Token.",
      "title": "BearerTokenHash",
      "type": "string"
    },
    "HumanSubject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/UserRole"
        },
        "user_id": {
          "$ref": "#/$defs/UserId"
        }
      },
      "required": [
        "user_id",
        "role"
      ],
      "title": "HumanSubject",
      "type": "object"
    },
    "UserId": {
      "title": "UserId",
      "type": "string"
    },
    "UserRole": {
      "enum": [
        "viewer",
        "operator",
        "admin"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persistable Token-hash-to-human mapping loaded by the authentication boundary.",
  "properties": {
    "schema_version": {
      "const": "bearer-token-binding/v1",
      "default": "bearer-token-binding/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/HumanSubject"
    },
    "token_hash": {
      "$ref": "#/$defs/BearerTokenHash"
    }
  },
  "required": [
    "token_hash",
    "subject"
  ],
  "title": "BearerTokenBinding",
  "type": "object"
}
