{
  "$defs": {
    "ArtifactId": {
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "ArtifactProducer",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "content_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ArtifactProducer"
        },
        "schema_version": {
          "const": "artifact-ref/v1",
          "default": "artifact-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "size_bytes": {
          "maximum": 100000000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "content_type",
        "size_bytes",
        "producer"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DeploymentId": {
      "title": "DeploymentId",
      "type": "string"
    },
    "LatencySummary": {
      "additionalProperties": false,
      "properties": {
        "e2e_ms": {
          "$ref": "#/$defs/PercentileValues"
        },
        "itl_ms": {
          "$ref": "#/$defs/PercentileValues"
        },
        "tpot_ms": {
          "$ref": "#/$defs/PercentileValues"
        },
        "ttft_ms": {
          "$ref": "#/$defs/PercentileValues"
        }
      },
      "required": [
        "e2e_ms",
        "ttft_ms",
        "tpot_ms",
        "itl_ms"
      ],
      "title": "LatencySummary",
      "type": "object"
    },
    "LengthSummary": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/PercentileValues"
        },
        "output_tokens": {
          "$ref": "#/$defs/PercentileValues"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "title": "LengthSummary",
      "type": "object"
    },
    "MeasuredProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "raw_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source": {
          "const": "measured",
          "default": "measured",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_version",
        "adapter_version",
        "raw_artifact"
      ],
      "title": "MeasuredProvenance",
      "type": "object"
    },
    "PercentileValues": {
      "additionalProperties": false,
      "properties": {
        "p50": {
          "minimum": 0,
          "title": "P50",
          "type": "number"
        },
        "p95": {
          "minimum": 0,
          "title": "P95",
          "type": "number"
        },
        "p99": {
          "minimum": 0,
          "title": "P99",
          "type": "number"
        }
      },
      "required": [
        "p50",
        "p95",
        "p99"
      ],
      "title": "PercentileValues",
      "type": "object"
    },
    "PlanHash": {
      "description": "RFC 8785 canonical execution-specification digest.",
      "title": "PlanHash",
      "type": "string"
    },
    "ReliabilitySummary": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "completed_within_window": {
          "minimum": 0,
          "title": "Completed Within Window",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "submitted": {
          "minimum": 1,
          "title": "Submitted",
          "type": "integer"
        },
        "success_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Success Rate",
          "type": "number"
        },
        "timed_out": {
          "minimum": 0,
          "title": "Timed Out",
          "type": "integer"
        },
        "window_completion_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Window Completion Ratio",
          "type": "number"
        }
      },
      "required": [
        "submitted",
        "completed",
        "failed",
        "timed_out",
        "completed_within_window",
        "success_rate",
        "window_completion_ratio"
      ],
      "title": "ReliabilitySummary",
      "type": "object"
    },
    "Sha256Digest": {
      "description": "Lowercase SHA-256 digest with an explicit algorithm prefix.",
      "title": "Sha256Digest",
      "type": "string"
    },
    "ThroughputSummary": {
      "additionalProperties": false,
      "properties": {
        "input_tokens_per_second": {
          "minimum": 0,
          "title": "Input Tokens Per Second",
          "type": "number"
        },
        "requests_per_second": {
          "minimum": 0,
          "title": "Requests Per Second",
          "type": "number"
        },
        "successful_output_tokens_per_second": {
          "minimum": 0,
          "title": "Successful Output Tokens Per Second",
          "type": "number"
        },
        "successful_requests_per_minute": {
          "minimum": 0,
          "title": "Successful Requests Per Minute",
          "type": "number"
        },
        "total_tokens_per_minute": {
          "minimum": 0,
          "title": "Total Tokens Per Minute",
          "type": "number"
        }
      },
      "required": [
        "requests_per_second",
        "successful_requests_per_minute",
        "input_tokens_per_second",
        "successful_output_tokens_per_second",
        "total_tokens_per_minute"
      ],
      "title": "ThroughputSummary",
      "type": "object"
    },
    "TrafficMode": {
      "enum": [
        "baseline",
        "closed_loop_sweep",
        "open_loop_sweep",
        "sla_search"
      ],
      "title": "TrafficMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "compiled_benchmark_hash": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "deployment_id": {
      "$ref": "#/$defs/DeploymentId"
    },
    "deployment_plan_hash": {
      "$ref": "#/$defs/PlanHash"
    },
    "latency": {
      "$ref": "#/$defs/LatencySummary"
    },
    "lengths": {
      "$ref": "#/$defs/LengthSummary"
    },
    "measurement_duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Measurement Duration Seconds",
      "type": "number"
    },
    "oom": {
      "title": "Oom",
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/MeasuredProvenance"
    },
    "provider": {
      "const": "evalscope",
      "default": "evalscope",
      "title": "Provider",
      "type": "string"
    },
    "provider_profile_hash": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "provider_profile_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Provider Profile Version",
      "type": "string"
    },
    "provider_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "raw_report_hash": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "reliability": {
      "$ref": "#/$defs/ReliabilitySummary"
    },
    "scheduled_window_seconds": {
      "exclusiveMinimum": 0,
      "title": "Scheduled Window Seconds",
      "type": "number"
    },
    "schema_version": {
      "const": "benchmark-result/v1",
      "default": "benchmark-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "throughput": {
      "$ref": "#/$defs/ThroughputSummary"
    },
    "traffic_mode": {
      "$ref": "#/$defs/TrafficMode"
    }
  },
  "required": [
    "provider_version",
    "adapter_version",
    "provider_profile_version",
    "provider_profile_hash",
    "compiled_benchmark_hash",
    "deployment_id",
    "deployment_plan_hash",
    "traffic_mode",
    "scheduled_window_seconds",
    "measurement_duration_seconds",
    "latency",
    "throughput",
    "reliability",
    "lengths",
    "oom",
    "raw_report_hash",
    "provenance"
  ],
  "title": "BenchmarkResult",
  "type": "object"
}
