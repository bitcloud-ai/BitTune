{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalId": {
      "title": "ApprovalId",
      "type": "string"
    },
    "PlanHash": {
      "description": "RFC 8785 canonical execution-specification digest.",
      "title": "PlanHash",
      "type": "string"
    },
    "PlanId": {
      "title": "PlanId",
      "type": "string"
    },
    "ToolName": {
      "description": "Agent-visible tool name restricted to the public action vocabulary.",
      "title": "ToolName",
      "type": "string"
    },
    "UserId": {
      "title": "UserId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ToolName"
    },
    "approval_id": {
      "$ref": "#/$defs/ApprovalId"
    },
    "comment": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision",
      "default": "pending"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "plan_hash": {
      "$ref": "#/$defs/PlanHash"
    },
    "plan_id": {
      "$ref": "#/$defs/PlanId"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requester_id": {
      "$ref": "#/$defs/UserId"
    },
    "risk_level": {
      "const": "L2",
      "default": "L2",
      "title": "Risk Level",
      "type": "string"
    },
    "schema_version": {
      "const": "approval/v1",
      "default": "approval/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "plan_id",
    "plan_hash",
    "action",
    "requester_id",
    "requested_at",
    "expires_at"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}
