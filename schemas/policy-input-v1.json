{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalId": {
      "title": "ApprovalId",
      "type": "string"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_disk_growth_bytes": {
          "maximum": 20000000000,
          "minimum": 1,
          "title": "Max Disk Growth Bytes",
          "type": "integer"
        },
        "max_duration_seconds": {
          "maximum": 1800,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_input_tokens": {
          "maximum": 50000000,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "maximum": 50000000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_requests": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "schema_version": {
          "const": "execution-budget/v1",
          "default": "execution-budget/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "max_duration_seconds",
        "max_requests",
        "max_input_tokens",
        "max_output_tokens",
        "max_disk_growth_bytes"
      ],
      "title": "ExecutionBudget",
      "type": "object"
    },
    "ExperimentId": {
      "title": "ExperimentId",
      "type": "string"
    },
    "ExperimentPhase": {
      "enum": [
        "requirements",
        "environment",
        "planning",
        "approval",
        "deployment",
        "benchmark",
        "optimization",
        "verification",
        "report",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "ExperimentPhase",
      "type": "string"
    },
    "PlanHash": {
      "description": "RFC 8785 canonical execution-specification digest.",
      "title": "PlanHash",
      "type": "string"
    },
    "PlanId": {
      "title": "PlanId",
      "type": "string"
    },
    "PolicyApproval": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ToolName"
        },
        "approval_id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "decided_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicySubject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "experiment_id": {
          "$ref": "#/$defs/ExperimentId"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "plan_hash": {
          "$ref": "#/$defs/PlanHash"
        },
        "plan_id": {
          "$ref": "#/$defs/PlanId"
        },
        "requester": {
          "$ref": "#/$defs/PolicySubject"
        }
      },
      "required": [
        "approval_id",
        "experiment_id",
        "plan_id",
        "plan_hash",
        "action",
        "decision",
        "requester",
        "expires_at"
      ],
      "title": "PolicyApproval",
      "type": "object"
    },
    "PolicyBudget": {
      "additionalProperties": false,
      "properties": {
        "ceiling": {
          "$ref": "#/$defs/ExecutionBudget"
        },
        "requested": {
          "$ref": "#/$defs/ExecutionBudget"
        }
      },
      "required": [
        "requested",
        "ceiling"
      ],
      "title": "PolicyBudget",
      "type": "object"
    },
    "PolicyEvaluationPurpose": {
      "enum": [
        "visibility",
        "execution"
      ],
      "title": "PolicyEvaluationPurpose",
      "type": "string"
    },
    "PolicyHumanSubject": {
      "additionalProperties": false,
      "description": "Credential-free human identity snapshot sent to OPA.",
      "properties": {
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/UserRole"
        },
        "user_id": {
          "$ref": "#/$defs/UserId"
        }
      },
      "required": [
        "user_id",
        "role"
      ],
      "title": "PolicyHumanSubject",
      "type": "object"
    },
    "PolicyPlan": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "$ref": "#/$defs/ExperimentId"
        },
        "plan_hash": {
          "$ref": "#/$defs/PlanHash"
        },
        "plan_id": {
          "$ref": "#/$defs/PlanId"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        }
      },
      "required": [
        "experiment_id",
        "plan_id",
        "plan_hash",
        "risk_level"
      ],
      "title": "PolicyPlan",
      "type": "object"
    },
    "PolicyServiceSubject": {
      "additionalProperties": false,
      "description": "Credential-free internal service identity snapshot sent to OPA.",
      "properties": {
        "kind": {
          "const": "service",
          "default": "service",
          "title": "Kind",
          "type": "string"
        },
        "service_name": {
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "title": "Service Name",
          "type": "string"
        }
      },
      "required": [
        "service_name"
      ],
      "title": "PolicyServiceSubject",
      "type": "object"
    },
    "PolicySubject": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyHumanSubject"
        },
        {
          "$ref": "#/$defs/PolicyServiceSubject"
        }
      ]
    },
    "PolicyTool": {
      "additionalProperties": false,
      "properties": {
        "allowed_phases": {
          "items": {
            "$ref": "#/$defs/ExperimentPhase"
          },
          "minItems": 1,
          "title": "Allowed Phases",
          "type": "array"
        },
        "allowed_roles": {
          "items": {
            "$ref": "#/$defs/UserRole"
          },
          "minItems": 1,
          "title": "Allowed Roles",
          "type": "array"
        },
        "environment_supported": {
          "title": "Environment Supported",
          "type": "boolean"
        },
        "feature_flags_enabled": {
          "title": "Feature Flags Enabled",
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/ToolName"
        },
        "provider_enabled": {
          "title": "Provider Enabled",
          "type": "boolean"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "schema_version": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema_version",
        "risk_level",
        "allowed_phases",
        "allowed_roles",
        "environment_supported",
        "provider_enabled",
        "feature_flags_enabled"
      ],
      "title": "PolicyTool",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ToolName": {
      "description": "Agent-visible tool name restricted to the public action vocabulary.",
      "title": "ToolName",
      "type": "string"
    },
    "UserId": {
      "title": "UserId",
      "type": "string"
    },
    "UserRole": {
      "enum": [
        "viewer",
        "operator",
        "admin"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyApproval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyBudget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "current_time": {
      "format": "date-time",
      "title": "Current Time",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/ExperimentPhase"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "purpose": {
      "$ref": "#/$defs/PolicyEvaluationPurpose"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "policy-input/v1",
      "default": "policy-input/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/PolicySubject"
    },
    "tool": {
      "$ref": "#/$defs/PolicyTool"
    }
  },
  "required": [
    "request_id",
    "purpose",
    "current_time",
    "phase",
    "subject",
    "tool"
  ],
  "title": "PolicyInput",
  "type": "object"
}
