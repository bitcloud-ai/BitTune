[Unit]
Description=BitTune Autopilot privileged host runner
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=autopilot-runner
Group=autopilot-runner
WorkingDirectory=/opt/autopilot/current
ExecStart=/opt/autopilot/venv/bin/python -m runner
Restart=on-failure
RestartSec=5s
UMask=0007
Environment=AUTOPILOT_RUNNER_RUNTIME_ROOT=/opt/autopilot/runtime
Environment=AUTOPILOT_RUNNER_MODEL_CACHE_ROOT=/var/lib/autopilot/model-cache
Environment=AUTOPILOT_RUNNER_OUTPUT_ROOT=/var/lib/autopilot/output
Environment=AUTOPILOT_RUNNER_TEMP_ROOT=/var/lib/autopilot/tmp
# These two immutable image references are mandatory and are supplied by the
# deployment-specific drop-in after G0 verification:
# Environment=AUTOPILOT_RUNNER_VLLM_IMAGE=repository@sha256:<64-lowercase-hex>
# Environment=AUTOPILOT_RUNNER_EVALSCOPE_IMAGE=repository@sha256:<64-lowercase-hex>
# Environment=AUTOPILOT_RUNNER_PLANNER_IMAGE=repository@sha256:<64-lowercase-hex>

# Credentials are installed with LoadCredential= in the deployment-specific
# drop-in.  The application receives only logical SecretRef names.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/autopilot/runtime /var/lib/autopilot /run/docker.sock /var/run/docker.sock

[Install]
WantedBy=multi-user.target
